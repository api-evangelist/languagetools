            "name": "Add word to a dictionary",
            "description": {
              "content": "Add a word to one of the user's personal dictionaries. Please note that this feature is considered to be used for personal dictionaries which must not contain more than 500 words. If this is an issue for you, please contact us.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "words",
                "add"
              ],
              "host": [
