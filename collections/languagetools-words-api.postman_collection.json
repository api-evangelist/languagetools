                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "disabled": false,
                  "key": "word",
                  "value": "<string>",
                  "description": "(Required) The word to be added. Must not be a phrase, i.e. cannot contain white space. The word is added to a global dictionary that applies to all languages."
                },
                {
                  "disabled": false,
                  "key": "username",
                  "value": "<string>",
                  "description": "(Required) Your username as used to log in at languagetool.org."
